"""Prebuilt ruff (GitHub release). Fetched for the exec OS/CPU; not stored in git."""

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

_RUFF = "0.16.10"

_RUFF_URL = "https://github.com/astral-sh/ruff/releases/download/{version}/ruff-{platform}"

_UNIX_BUILD = """exports_files(["ruff"], visibility = ["//visibility:public"])"""

_WIN_BUILD = """exports_files(["ruff.exe"], visibility = ["//visibility:public"])"""

http_archive(
    name = "ruff_linux_amd64",
    build_file_content = _UNIX_BUILD,
    sha256 = "9567ff1201e2fb3da31ff04c35587d768c66d6cb42dfa84de474e2bfe360b608",
    strip_prefix = "ruff-x86_64-unknown-linux-gnu",
    urls = [_RUFF_URL.format(
        platform = "x86_64-unknown-linux-gnu.tar.gz",
        version = _RUFF,
    )],
)

http_archive(
    name = "ruff_linux_arm64",
    build_file_content = _UNIX_BUILD,
    sha256 = "dc0d74de837ef0a7bcc62ce98c48a622b075d057161f13b958be2934becd55a6",
    strip_prefix = "ruff-aarch64-unknown-linux-gnu",
    urls = [_RUFF_URL.format(
        platform = "aarch64-unknown-linux-gnu.tar.gz",
        version = _RUFF,
    )],
)

http_archive(
    name = "ruff_darwin_amd64",
    build_file_content = _UNIX_BUILD,
    sha256 = "ace641df42926e962cf04bc52c79eb6c50ba1ae6a17b602f081960616ecc1bd1",
    strip_prefix = "ruff-x86_64-apple-darwin",
    urls = [_RUFF_URL.format(
        platform = "x86_64-apple-darwin.tar.gz",
        version = _RUFF,
    )],
)

http_archive(
    name = "ruff_darwin_arm64",
    build_file_content = _UNIX_BUILD,
    sha256 = "f051cd306de2691262a0574f8857cd1f4d6bfcd448084ea23d61b9c1c37df510",
    strip_prefix = "ruff-aarch64-apple-darwin",
    urls = [_RUFF_URL.format(
        platform = "aarch64-apple-darwin.tar.gz",
        version = _RUFF,
    )],
)

# Windows cargo-dist zips put ruff.exe at the archive root (no strip_prefix).
http_archive(
    name = "ruff_windows_amd64",
    build_file_content = _WIN_BUILD,
    sha256 = "6b90457fbd249923db196044d5f3c26e4f7cefacc769c26fd52520fa033f736e",
    urls = [_RUFF_URL.format(
        platform = "x86_64-pc-windows-msvc.zip",
        version = _RUFF,
    )],
)

http_archive(
    name = "ruff_windows_arm64",
    build_file_content = _WIN_BUILD,
    sha256 = "cde60dbdf2697144474e6d87b8b51b73bb1fd218f4c180acb40abbd3b659d56f",
    urls = [_RUFF_URL.format(
        platform = "aarch64-pc-windows-msvc.zip",
        version = _RUFF,
    )],
)
