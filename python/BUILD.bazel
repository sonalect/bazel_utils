load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")

package(default_visibility = ["//visibility:public"])

# Prebuilt GitHub release; select is the exec platform (host that runs the tool).
native_binary(
    name = "ruff",
    src = select(
        {
            "@bazel_utils_core//:linux_amd64": "@ruff_linux_amd64//:ruff",
            "@bazel_utils_core//:linux_arm64": "@ruff_linux_arm64//:ruff",
            "@bazel_utils_core//:darwin_amd64": "@ruff_darwin_amd64//:ruff",
            "@bazel_utils_core//:darwin_arm64": "@ruff_darwin_arm64//:ruff",
            "@bazel_utils_core//:windows_amd64": "@ruff_windows_amd64//:ruff.exe",
            "@bazel_utils_core//:windows_arm64": "@ruff_windows_arm64//:ruff.exe",
        },
        no_match_error = "No prebuilt ruff for this OS/CPU",
    ),
    # Windows only runs files with an executable extension.
    out = select({
        "@bazel_utils_core//:windows": "ruff.exe",
        "//conditions:default": "ruff.bin",
    }),
)

# Prebuilt GitHub release; select is the exec platform (host that runs the tool).
native_binary(
    name = "uv",
    src = select(
        {
            "@bazel_utils_core//:linux_amd64": "@uv_linux_amd64//:uv",
            "@bazel_utils_core//:linux_arm64": "@uv_linux_arm64//:uv",
            "@bazel_utils_core//:darwin_amd64": "@uv_darwin_amd64//:uv",
            "@bazel_utils_core//:darwin_arm64": "@uv_darwin_arm64//:uv",
            "@bazel_utils_core//:windows_amd64": "@uv_windows_amd64//:uv.exe",
            "@bazel_utils_core//:windows_arm64": "@uv_windows_arm64//:uv.exe",
        },
        no_match_error = "No prebuilt uv for this OS/CPU",
    ),
    # Windows only runs files with an executable extension.
    out = select({
        "@bazel_utils_core//:windows": "uv.exe",
        "//conditions:default": "uv.bin",
    }),
)

bzl_library(
    name = "ruff_bzl",
    srcs = ["ruff.bzl"],
    deps = [
        "@bazel_utils_core//internal:labels",
        "@bazel_utils_core//internal:workspace_tool",
    ],
)

bzl_library(
    name = "uv_audit_bzl",
    srcs = ["uv_audit.bzl"],
    deps = [
        "@bazel_skylib//lib:shell",
        "@bazel_utils_core//internal:launcher",
        "@bazel_utils_core//internal:workspace_tool",
    ],
)

bzl_library(
    name = "python",
    srcs = ["python.bzl"],
    deps = [
        ":ruff_bzl",
        ":uv_audit_bzl",
    ],
)
