"""pip-audit from this module's uv.lock; prebuilt ruff from GitHub."""

module(
    name = "bazel_utils_python",
    version = "0.2.14",
)

bazel_dep(name = "aspect_rules_py", version = "1.12.1")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazel_utils_core", version = "0.2.14")
bazel_dep(name = "rules_python", version = "2.3.4")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.14")
python.toolchain(python_version = "3.14")

# Pinned here, not rules_py's default. sha256 from the release's sha256.sum:
# https://github.com/astral-sh/uv/releases/download/0.12.23/sha256.sum
uv_bin = use_extension("@aspect_rules_py//uv/unstable:extension.bzl", "uv_bin")
uv_bin.toolchain(
    sha256s = {
        "aarch64-apple-darwin": "50487ae565ccd96e499056b4674d438f4c53170202617b4c759defe0c6a1b544",
        "aarch64-pc-windows-msvc": "13294e232ececbe709c06b74e6ced06f2a225ea5591476685362f22be56a50d5",
        "aarch64-unknown-linux-musl": "b536543cc4d50661986b165c76ee8aa9056e4fa332edcd153ff2e98760f9359b",
        "x86_64-apple-darwin": "960da44cb4b73685206ddd250b19e0a117fa41095710c1038f081f5cb613efb4",
        "x86_64-pc-windows-msvc": "75d05de6762778c31ee183398de7dd15093fad0ed90b1f236d8205ea5ec00c90",
        "x86_64-unknown-linux-musl": "1cff8783850e794470aadb73f54b749542a511fc57b0ce6468b64bd3852e0ade",
    },
    version = "0.12.23",
)
use_repo(uv_bin, "uv")

uv = use_extension("@aspect_rules_py//uv/unstable:extension.bzl", "uv")
uv.declare_hub(
    hub_name = "bazel_utils_pypi",
)
uv.project(
    default_build_dependencies = [
        "setuptools",
        "build",
        "wheel",
    ],
    hub_name = "bazel_utils_pypi",
    lock = "//:uv.lock",
    pyproject = "//:pyproject.toml",
)
use_repo(uv, "bazel_utils_pypi")

include("//:ruff.MODULE.bazel")
