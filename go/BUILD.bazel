load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load(":dirs_test.bzl", "go_list_patterns_test")

package(default_visibility = ["//visibility:public"])

# Prebuilt GitHub release; select is the exec platform (host that runs the tool).
native_binary(
    name = "golangci-lint",
    src = select(
        {
            "@bazel_utils_core//:linux_amd64": "@golangci_lint_linux_amd64//:golangci-lint",
            "@bazel_utils_core//:linux_arm64": "@golangci_lint_linux_arm64//:golangci-lint",
            "@bazel_utils_core//:darwin_amd64": "@golangci_lint_darwin_amd64//:golangci-lint",
            "@bazel_utils_core//:darwin_arm64": "@golangci_lint_darwin_arm64//:golangci-lint",
            "@bazel_utils_core//:windows_amd64": "@golangci_lint_windows_amd64//:golangci-lint.exe",
            "@bazel_utils_core//:windows_arm64": "@golangci_lint_windows_arm64//:golangci-lint.exe",
        },
        no_match_error = "No prebuilt golangci-lint for this OS/CPU",
    ),
    # Windows only runs files with an executable extension.
    out = select({
        "@bazel_utils_core//:windows": "golangci-lint.exe",
        "//conditions:default": "golangci-lint.bin",
    }),
)

# govulncheck from this module's go.mod (gazelle-generated binary in go_deps).
alias(
    name = "govulncheck",
    actual = "@org_golang_x_vuln//cmd/govulncheck:govulncheck",
)

bzl_library(
    name = "go_sdk_env",
    srcs = ["go_sdk_env.bzl"],
)

bzl_library(
    name = "go_workspace_tool",
    srcs = ["go_workspace_tool.bzl"],
    deps = [
        ":go_sdk_env",
        "@bazel_skylib//lib:shell",
        "@bazel_utils_core//internal:runfiles",
        "@bazel_utils_core//internal:workspace_tool",
    ],
)

bzl_library(
    name = "dirs",
    srcs = ["dirs.bzl"],
    deps = ["@bazel_utils_core//internal:labels"],
)

bzl_library(
    name = "golangci",
    srcs = ["golangci.bzl"],
    deps = [
        ":dirs",
        ":go_workspace_tool",
        "@bazel_utils_core//internal:workspace_tool",
    ],
)

bzl_library(
    name = "govulncheck_bzl",
    srcs = ["govulncheck.bzl"],
    deps = [
        ":dirs",
        ":go_workspace_tool",
        "@bazel_utils_core//internal:workspace_tool",
    ],
)

bzl_library(
    name = "go",
    srcs = ["go.bzl"],
    deps = [
        ":golangci",
        ":govulncheck_bzl",
    ],
)

go_list_patterns_test(
    name = "go_list_patterns_test",
    size = "small",
)
