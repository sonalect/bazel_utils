load("@bazel_utils_buf//:buf.bzl", "buf_format", "buf_generate", "buf_lint_test", "buf_module", "buf_plugin")
load("@bazel_utils_buf//:protoc_prefix.bzl", "protoc_prefix")
load(":layout.bzl", "generate_layout_check")

# Smoke tests for the buf rules and every prebuilt plugin on each CI platform.

buf_module(
    name = "module",
    srcs = ["proto/smoke/v1/smoke.proto"],
    config = "buf.yaml",
    deps = ["//tests/buf/deps:common"],
)

buf_generate(
    name = "plugins",
    module = ":module",
    plugins = [
        "@bazel_utils_buf//protoc/plugins/protoc-gen-buffa",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-buffa-packaging",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-connect-go",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-connect-rust",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-go",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-grpc-gateway",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-openapiv2",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-protocontract-buffa",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-protovalidate-buffa",
    ],
    template = "buf.gen.all.yaml",
)

# The plugins write into sibling directories (gen/go, gen/openapi, gen/rust/*),
# and the first one holds several files. buf_generate must keep all of them: on
# Windows it once found the common directory wrongly and kept only `go/`.
generate_layout_check(
    name = "plugins_layout",
    files = [
        "go/smoke/v1/smoke.pb.go",
        "openapi/smoke/v1/smoke.swagger.json",
        "rust/buffa/smoke.v1.smoke.rs",
        "rust/packaging/mod.rs",
    ],
    generated = ":plugins",
)

buf_plugin(
    name = "protoc-gen-go-renamed",
    actual = "@bazel_utils_buf//protoc/plugins/protoc-gen-go",
)

buf_generate(
    name = "renamed",
    module = ":module",
    plugins = [":protoc-gen-go-renamed"],
    template = "buf.gen.renamed.yaml",
)

buf_lint_test(
    name = "lint",
    size = "small",
    module = ":module",
)

buf_format(
    name = "format",
    module = ":module",
)

# The protoc of the proto toolchain must be a prebuilt one on every exec
# platform, Windows ARM64 included (protoc_prefix fails on a from-source protoc).
protoc_prefix(
    name = "protoc_prefix",
    wkts = [
        "@protobuf//:descriptor_proto_srcs",
        "@protobuf//:well_known_type_protos",
    ],
)
