load("@bazel_utils_buf//:buf.bzl", "buf_format", "buf_generate", "buf_lint_test", "buf_module", "buf_plugin")

# Smoke tests for the buf rules and every prebuilt plugin on each CI platform.

buf_module(
    name = "module",
    srcs = ["proto/smoke/v1/smoke.proto"],
    config = "buf.yaml",
    deps = ["//tests/buf/deps:common"],
)

buf_generate(
    name = "plugins",
    module = ":module",
    plugins = [
        "@bazel_utils_buf//protoc/plugins/protoc-gen-buffa",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-buffa-packaging",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-connect-go",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-connect-rust",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-contract-rust",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-go",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-grpc-gateway",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-openapiv2",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-protovalidate-buffa",
    ],
    template = "buf.gen.all.yaml",
)

buf_plugin(
    name = "protoc-gen-go-renamed",
    actual = "@bazel_utils_buf//protoc/plugins/protoc-gen-go",
)

buf_generate(
    name = "renamed",
    module = ":module",
    plugins = [":protoc-gen-go-renamed"],
    template = "buf.gen.renamed.yaml",
)

buf_lint_test(
    name = "lint",
    size = "small",
    module = ":module",
)

buf_format(
    name = "format",
    module = ":module",
)
