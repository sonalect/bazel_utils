"""Prebuilt buildifier (GitHub release). Fetched for the exec OS/CPU; not stored in git."""

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

_BUILDIFIER = "10.1.0"

_BUILDIFIER_URL = "https://github.com/bazelbuild/buildtools/releases/download/v{version}/buildifier-{platform}"

http_file(
    name = "buildifier_linux_amd64",
    downloaded_file_path = "buildifier",
    executable = True,
    sha256 = "31b6a8aa1e5c746696788f428729701770ad91925873d8256cb885c60e12c77e",
    urls = [_BUILDIFIER_URL.format(
        platform = "linux-amd64",
        version = _BUILDIFIER,
    )],
)

