"""markdownlint-cli2 from this module's pnpm lock."""

module(
    name = "bazel_utils_md",
    version = "0.4.3",
)

bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazel_utils_core", version = "0.4.3")
bazel_dep(name = "rules_nodejs", version = "6.7.7")

# In rules_nodejs 6.7.7's catalog (sha256s match
# https://nodejs.org/dist/v24.22.1/SHASUMS256.txt).
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.22.1")

# Newer than rules_js 3.5.2's catalog, so the integrity comes from npm
# (https://registry.npmjs.org/pnpm/12.15.0, dist.integrity).
# Keep in sync with package.json `packageManager`.
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    pnpm_version = "12.15.0",
    pnpm_version_integrity = "sha512-s5UdbW/0qfE9x89WzSjSuOs328ycaOUuHhGRhz6p+CoBcoerULqtxczElPA2xnwOR+sTYIwvo29HcRth6hKOYQ==",
)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")
